<UserControl x:Class="AstroHybrid.App.Views.InstallationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AstroHybrid.App.Views"
             xmlns:vm="clr-namespace:AstroHybrid.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="ButtonGlyphStyle" TargetType="Path">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
        <Style x:Key="KeyStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="Width" Value="130"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- One definition row inside a card -->
        <Style x:Key="DefRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,20">
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="INSTALLATION" Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock Text="What is on disk" Style="{StaticResource TitleTextStyle}" FontSize="26" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Status -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0"
                                     Fill="{Binding State.IsInstalled, Converter={StaticResource BoolToStatusBrushConverter}}"/>
                            <TextBlock Text="{Binding State.IsInstalled, Converter={StaticResource BoolToStatusConverter}}"
                                       Style="{StaticResource SectionHeaderStyle}" Margin="0"
                                       Foreground="{Binding State.IsInstalled, Converter={StaticResource BoolToStatusBrushConverter}}"/>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource ChipStyle}" Margin="0">
                            <TextBlock Style="{StaticResource ChipTextStyle}">
                                <Run Text="{Binding InstallSize, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Run Text=" on disk" Foreground="{StaticResource TextMutedBrush}"/>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <Grid Style="{StaticResource DefRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Install path"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ValueStyle}" Text="{Binding InstallPath}"
                                   FontFamily="{StaticResource FontFamilyMono}" FontSize="12"/>
                    </Grid>

                    <Grid Style="{StaticResource DefRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Game dump"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ValueStyle}" Text="{Binding GameDumpPath}"
                                   FontFamily="{StaticResource FontFamilyMono}" FontSize="12"/>
                    </Grid>

                    <Grid Style="{StaticResource DefRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Game version"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ValueStyle}" Text="{Binding GameVersion}"/>
                    </Grid>

                    <Grid Style="{StaticResource DefRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Title ID"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ValueStyle}" Text="{Binding GameTitleId}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Installed"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ValueStyle}" Text="{Binding InstalledAt}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Tool versions -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Runtime components" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Style="{StaticResource DefRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource KeyStyle}" Text="AnyPS5"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ValueStyle}" Text="{Binding AnyPs5Version}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource KeyStyle}" Text="Kyty GPU"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ValueStyle}" Text="{Binding KytyVersion}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Maintenance -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Maintenance" Style="{StaticResource SectionHeaderStyle}"/>

                    <WrapPanel>
                        <Button Command="{Binding RepairCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                                MinWidth="112" MinHeight="36" FontSize="12.5">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonGlyphStyle}"
                                      Data="M12.6,3.6 A4.4,4.4 0 0 0 6.1,8.9 L3.4,11.6 A1.7,1.7 0 0 0 5.8,14 L8.5,11.3 A4.4,4.4 0 0 0 13.8,4.8 L11.7,6.9 L10.6,5.8 Z"/>
                                <TextBlock Text="Repair" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding RebuildCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                                MinWidth="112" MinHeight="36" FontSize="12.5">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonGlyphStyle}"
                                      Data="M10,3.4 A6.6,6.6 0 1 0 16.6,10 M16.6,10 L16.6,5.6 M16.6,10 L12.4,10"/>
                                <TextBlock Text="Rebuild" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ChangeLocationCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                                MinWidth="140" MinHeight="36" FontSize="12.5">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonGlyphStyle}"
                                      Data="M2.8,5.6 L2.8,15.4 L17.2,15.4 L17.2,5.6 L9.4,5.6 L7.8,3.4 L2.8,3.4 Z M7.4,10.8 L12.6,10.8 M10.8,8.8 L12.8,10.8 L10.8,12.8"/>
                                <TextBlock Text="Change location" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <WrapPanel Margin="0,2,0,0">
                        <Button Command="{Binding OpenInstallFolderCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                                MinWidth="187" MinHeight="36" FontSize="12.5" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonGlyphStyle}"
                                      Data="M2.5,5.5 L2.5,15 L17.5,15 L17.5,5.5 L9.5,5.5 L8,3.2 L2.5,3.2 Z"/>
                                <TextBlock Text="Install folder" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenLogFolderCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="187" MinHeight="36" FontSize="12.5" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ButtonGlyphStyle}"
                                      Data="M4,2.5 L12,2.5 L16,6.5 L16,17.5 L4,17.5 Z M12,2.5 L12,6.5 L16,6.5"/>
                                <TextBlock Text="Logs" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Danger zone -->
            <Border Style="{StaticResource CardStyle}" BorderBrush="#3DFF5C6C" Background="#12FF5C6C">
                <StackPanel>
                    <TextBlock Text="Remove AstroHybrid" Style="{StaticResource SectionHeaderStyle}"
                               Foreground="{StaticResource ErrorBrush}"/>

                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,0,0,14" TextWrapping="Wrap">
                        These actions cannot be undone. Your original game dump is never touched.
                    </TextBlock>

                    <WrapPanel>
                        <Button Content="Run setup again" Command="{Binding RunSetupAgainCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" MinWidth="132" MinHeight="36"
                                FontSize="12.5" BorderBrush="#55FF5C6C" Foreground="{StaticResource WarningBrush}"/>
                        <Button Content="Uninstall" Command="{Binding UninstallCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" MinWidth="104" MinHeight="36" Margin="0,0,0,8"
                                FontSize="12.5" BorderBrush="#55FF5C6C" Foreground="{StaticResource WarningBrush}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
