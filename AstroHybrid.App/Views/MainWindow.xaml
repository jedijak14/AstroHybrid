<Window x:Class="AstroHybrid.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AstroHybrid.App.Views"
        xmlns:app="clr-namespace:AstroHybrid.App"
        xmlns:vm="clr-namespace:AstroHybrid.App.ViewModels"
        xmlns:models="clr-namespace:AstroHybrid.App.Models"
        mc:Ignorable="d"
        Title="AstroHybrid" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="900"
        Style="{StaticResource MainWindowStyle}"
        Icon="/Resources/astrohybrid.ico">


    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <app:UpdateStateToVisibilityConverter x:Key="UpdateStateToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <!--
            Nav glyphs are drawn as paths instead of emoji: emoji ignore the
            foreground brush, render in colour, and look different on every
            Windows build. These pick up the active/accent colour.
        -->
        <Geometry x:Key="IconHome">M3.2,9.7 L10,3.4 L16.8,9.7 M5.2,9 L5.2,16.4 L14.8,16.4 L14.8,9</Geometry>
        <Geometry x:Key="IconGraphics">M4,5 A1.4,1.4 0 0 1 5.4,3.6 L14.6,3.6 A1.4,1.4 0 0 1 16,5 L16,12.4 A1.4,1.4 0 0 1 14.6,13.8 L5.4,13.8 A1.4,1.4 0 0 1 4,12.4 Z M10,13.8 L10,16.2 M7.4,16.4 L12.6,16.4</Geometry>
        <Geometry x:Key="IconController">M6,7.6 L14,7.6 C15.9,7.6 17.2,9.1 17.2,11 L17.2,12.6 C17.2,14.1 16.2,14.8 15.1,14.8 C13.9,14.8 13.2,14 12.5,13.1 L7.5,13.1 C6.8,14 6.1,14.8 4.9,14.8 C3.8,14.8 2.8,14.1 2.8,12.6 L2.8,11 C2.8,9.1 4.1,7.6 6,7.6 Z M6.2,9.6 L8.4,9.6 M7.3,8.5 L7.3,10.7 M12.5,9.3 A0.58,0.58 0 1 1 12.49,9.3 M14,10.9 A0.58,0.58 0 1 1 13.99,10.9</Geometry>
        <Geometry x:Key="IconAdvanced">M3,7.2 L17,7.2 M3,13 L17,13 M7.4,7.2 A1.9,1.9 0 1 1 7.39,7.2 M12.9,13 A1.9,1.9 0 1 1 12.89,13</Geometry>
        <Geometry x:Key="IconInstallation">M10,2.6 L17,6.2 L17,13.8 L10,17.4 L3,13.8 L3,6.2 Z M3,6.2 L10,9.8 L17,6.2 M10,9.8 L10,17.4</Geometry>

        <!-- Controller-type glyphs, used by the connected-controller list -->
        <Geometry x:Key="IconPadPs">M6,7.6 L14,7.6 C15.9,7.6 17.2,9.1 17.2,11 L17.2,12.6 C17.2,14.1 16.2,14.8 15.1,14.8 C13.9,14.8 13.2,14 12.5,13.1 L7.5,13.1 C6.8,14 6.1,14.8 4.9,14.8 C3.8,14.8 2.8,14.1 2.8,12.6 L2.8,11 C2.8,9.1 4.1,7.6 6,7.6 Z M6.2,9.6 L8.4,9.6 M7.3,8.5 L7.3,10.7 M12.5,9.3 A0.58,0.58 0 1 1 12.49,9.3 M14,10.9 A0.58,0.58 0 1 1 13.99,10.9</Geometry>
        <Geometry x:Key="IconPadXbox">M10,3.2 A6.8,6.8 0 1 1 9.99,3.2 M7.2,7.2 L12.8,12.8 M12.8,7.2 L7.2,12.8</Geometry>
        <Geometry x:Key="IconPadSwitch">M3.4,8 A1.4,1.4 0 0 1 4.8,6.6 L7.6,6.6 L7.6,13.4 L4.8,13.4 A1.4,1.4 0 0 1 3.4,12 Z M16.6,8 A1.4,1.4 0 0 0 15.2,6.6 L12.4,6.6 L12.4,13.4 L15.2,13.4 A1.4,1.4 0 0 0 16.6,12 Z M5.2,9.2 A0.5,0.5 0 1 1 5.19,9.2 M14.1,9.6 L15.1,9.6 M14.6,9.1 L14.6,10.1</Geometry>
        <Geometry x:Key="IconPadGeneric">M5.5,7.9 L14.5,7.9 A3.2,3.2 0 0 1 17.7,11.1 L17.7,12 A2.1,2.1 0 0 1 14,13.4 L12.6,12.2 L7.4,12.2 L6,13.4 A2.1,2.1 0 0 1 2.3,12 L2.3,11.1 A3.2,3.2 0 0 1 5.5,7.9 Z</Geometry>

        <Style x:Key="NavIconStyle" TargetType="Path">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,11,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="SnapsToDevicePixels" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0"
                Width="228">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <Border Grid.Row="0" Padding="18,18,18,16"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Resources/astrohybrid-mark.png" Width="34" Height="34"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center"/>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="AstroHybrid" FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0">
                                <Run Text="Astro Bot for PC"/><Run Text=" · 1.1" Foreground="#FF4E5766"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="10,14,10,0">
                    <TextBlock Text="PLAY" Style="{StaticResource EyebrowTextStyle}" Margin="14,0,0,7"/>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Home}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Home">
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconHome}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Home" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=GraphicsSettings}"
                                 Command="{Binding NavigateCommand}" CommandParameter="GraphicsSettings"
                                 Margin="0,2,0,0">
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconGraphics}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Graphics" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ControllerSettings}"
                                 Command="{Binding NavigateCommand}" CommandParameter="ControllerSettings"
                                 Margin="0,2,0,0">
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconController}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Controller" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>

                    <TextBlock Text="SYSTEM" Style="{StaticResource EyebrowTextStyle}" Margin="14,20,0,7"/>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AdvancedSettings}"
                                 Command="{Binding NavigateCommand}" CommandParameter="AdvancedSettings">
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconAdvanced}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Advanced" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Installation}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Installation"
                                 Margin="0,2,0,0">
                        <RadioButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconInstallation}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Installation" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton.Content>
                    </RadioButton>
                </StackPanel>

                <!-- Footer status -->
                <Border Grid.Row="2" Padding="18,14"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0"
                                     Fill="{Binding InstallationState.IsInstalled, Converter={StaticResource BoolToStatusBrushConverter}}"/>
                            <TextBlock Text="Status" Style="{StaticResource EyebrowTextStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ProgressBar Value="{Binding IsLoading, Converter={StaticResource BoolToProgressConverter}}"
                                     Maximum="1" IsIndeterminate="{Binding IsLoading}"
                                     Style="{StaticResource ModernProgressBarStyle}" Height="3" Margin="0,9,0,0"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main content -->
        <Border Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Page content -->
                <ContentControl Grid.Row="0" Content="{Binding CurrentPage, Converter={StaticResource PageTemplateSelector}}"
                                Margin="24,22,24,0"/>

                <!-- Update banner -->
                <Border Grid.Row="0" VerticalAlignment="Top" Margin="24,22,24,0"
                        Visibility="{Binding ShowUpdateNotification, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{StaticResource SurfaceGradientBrush}" CornerRadius="12" Padding="16,14"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" VerticalAlignment="Center"
                                Background="#268B7CFF" Margin="0,0,14,0">
                            <Path Data="M10,15 L10,5 M6,9 L10,5 L14,9" Stroke="{StaticResource AccentBrightBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Update available" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding UpdateState.LatestUpdate.Version, StringFormat='AstroHybrid {0}'}"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                            <TextBlock Text="{Binding UpdateState.LatestUpdate.ReleaseNotes}" FontSize="11.5"
                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                       MaxWidth="520" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Update now" Command="{Binding DownloadUpdateCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" MinWidth="112" MinHeight="34"
                                FontSize="12.5" Margin="16,0,8,0" VerticalAlignment="Center"
                                Visibility="{Binding UpdateState.IsDownloading, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <Button Grid.Column="2" Content="Downloading…" Style="{StaticResource SecondaryButtonStyle}" MinWidth="112" MinHeight="34"
                                FontSize="12.5" Margin="16,0,8,0" IsEnabled="False" VerticalAlignment="Center"
                                Visibility="{Binding UpdateState.IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Grid.Column="3" Content="Later" Command="{Binding IgnoreUpdateCommand}"
                                Style="{StaticResource TextButtonStyle}" MinWidth="64" MinHeight="34"
                                FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding UpdateState.IsDownloading, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <Button Grid.Column="3" Content="Cancel" Command="{Binding DismissUpdateNotificationCommand}"
                                Style="{StaticResource TextButtonStyle}" MinWidth="64" MinHeight="34"
                                FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding UpdateState.IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- Action bar -->
                <Border Grid.Row="1" Padding="24,14" Background="#66090C12"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Tune for this PC" Command="{Binding ApplyBestSettingsCommand}"
                                    Style="{StaticResource TextButtonStyle}" Padding="10,8"
                                    Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibilityConverter}, ConverterParameter=GraphicsSettings}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Update" Command="{Binding DownloadUpdateCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="104" MinHeight="44"
                                    FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                    Visibility="{Binding UpdateState.UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    IsEnabled="{Binding UpdateState.UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="Play" Command="{Binding LaunchGameCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="150" MinHeight="44"
                                    FontSize="14.5" VerticalAlignment="Center"
                                    IsEnabled="{Binding InstallationState.IsInstalled}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
