<UserControl x:Class="AstroHybrid.App.Views.AdvancedSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AstroHybrid.App.Views"
             xmlns:vm="clr-namespace:AstroHybrid.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="RowLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="150"/>
        </Style>

        <!-- A checkbox plus its explanation, spaced consistently -->
        <Style x:Key="OptionCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBoxStyle}">
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <Style x:Key="OptionNoteStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsDescriptionStyle}">
            <Setter Property="Margin" Value="28,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,20">
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="ADVANCED" Style="{StaticResource EyebrowTextStyle}"/>
                <TextBlock Text="Renderer and runtime" Style="{StaticResource TitleTextStyle}" FontSize="26" Margin="0,4,0,0"/>
                <TextBlock Text="The defaults are tuned for this build; change these only if you know why."
                           Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Renderer -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Renderer" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Lighting"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding LightingLabels}"
                                  SelectedIndex="{Binding LightingIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="380"/>
                    </Grid>

                    <TextBlock Text="{Binding LightingNote}" Style="{StaticResource SettingsDescriptionStyle}"/>
                </StackPanel>
            </Border>

            <!-- Game speed -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Game speed" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Speed"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SpeedLabels}"
                                  SelectedIndex="{Binding SpeedIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="380"/>
                    </Grid>

                    <TextBlock Text="{Binding SpeedNote}" Style="{StaticResource SettingsDescriptionStyle}"/>
                </StackPanel>
            </Border>

            <!-- Language -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Language" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Game language"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding LanguageLabels}"
                                  SelectedIndex="{Binding LanguageIndex}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="380"/>
                    </Grid>

                    <TextBlock Text="{Binding LanguageNote}" Style="{StaticResource SettingsDescriptionStyle}"/>
                </StackPanel>
            </Border>

            <!-- Runtime options -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Runtime options" Style="{StaticResource SectionHeaderStyle}"/>

                    <CheckBox Content="Hang watchdog"
                              IsChecked="{Binding HangWatchdog}"
                              Style="{StaticResource ModernCheckBoxStyle}"/>
                    <TextBlock Text="{Binding HangWatchdogNote}" Style="{StaticResource OptionNoteStyle}"/>

                    <CheckBox Content="Persistent shader cache"
                              IsChecked="{Binding ShaderCache}"
                              Style="{StaticResource OptionCheckBoxStyle}"/>
                    <TextBlock Text="{Binding ShaderCacheNote}" Style="{StaticResource OptionNoteStyle}"/>

                    <CheckBox Content="Draw prep tuning"
                              IsChecked="{Binding DrawPrepTuning}"
                              Style="{StaticResource OptionCheckBoxStyle}"/>
                    <TextBlock Text="{Binding DrawPrepNote}" Style="{StaticResource OptionNoteStyle}"/>

                    <Border Style="{StaticResource ModernSeparatorStyle}"/>

                    <CheckBox Content="Motion controls"
                              IsChecked="{Binding MotionControls}"
                              Style="{StaticResource ModernCheckBoxStyle}"/>
                    <TextBlock Text="{Binding MotionNote}" Style="{StaticResource OptionNoteStyle}"/>

                    <CheckBox Content="Adaptive trigger state"
                              IsChecked="{Binding TriggerState}"
                              Style="{StaticResource OptionCheckBoxStyle}"/>
                    <TextBlock Text="{Binding TriggerNote2}" Style="{StaticResource OptionNoteStyle}"/>

                    <CheckBox Content="DualSense speaker over Bluetooth"
                              IsChecked="{Binding DualSenseWirelessSpeaker}"
                              Style="{StaticResource OptionCheckBoxStyle}"/>
                    <TextBlock Text="{Binding DualSenseWirelessSpeakerNote}" Style="{StaticResource OptionNoteStyle}"/>

                    <CheckBox Content="DualSense haptics over Bluetooth"
                              IsChecked="{Binding DualSenseWirelessHaptics}"
                              Style="{StaticResource OptionCheckBoxStyle}"/>
                    <TextBlock Text="{Binding DualSenseWirelessHapticsNote}" Style="{StaticResource OptionNoteStyle}"/>
                </StackPanel>
            </Border>

            <!-- Priority -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Process priority" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Game process"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding PriorityOptions}"
                                  SelectedItem="{Binding Priority}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="200"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Command processor" Margin="0,10,0,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding CpPriorityOptions}"
                                  SelectedItem="{Binding CpPriority}"
                                  Style="{StaticResource ModernComboBoxStyle}" Width="200" Margin="0,10,0,0"/>
                    </Grid>

                    <TextBlock Text="{Binding PriorityNote}" Style="{StaticResource SettingsDescriptionStyle}"/>
                </StackPanel>
            </Border>

            <!-- Experimental -->
            <Border Style="{StaticResource CardStyle}">
                <Expander Header="Experimental features" IsExpanded="{Binding IsExperimentalExpanded}"
                          Foreground="{StaticResource TextPrimaryBrush}">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding ExperimentalWarning}" Style="{StaticResource ErrorTextStyle}" Margin="0,0,0,12"/>
                        <TextBlock Text="Experimental switches appear here once they have been validated on real hardware."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
