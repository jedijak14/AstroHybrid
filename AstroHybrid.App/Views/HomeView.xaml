<UserControl x:Class="AstroHybrid.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AstroHybrid.App.Views"
             xmlns:app="clr-namespace:AstroHybrid.App"
             xmlns:vm="clr-namespace:AstroHybrid.App.ViewModels"
             xmlns:models="clr-namespace:AstroHybrid.App.Models"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <app:UpdateStateToVisibilityConverter x:Key="UpdateStateToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">
            <!-- Hero -->
            <Border Style="{StaticResource HeroCardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0">
                        <TextBlock Text="ASTROHYBRID" Style="{StaticResource EyebrowTextStyle}"/>

                        <TextBlock Text="ASTRO BOT" Style="{StaticResource HeroTitleStyle}" Margin="0,7,0,0"/>
                        <TextBlock Text="Native PC port, running through AstroHybrid"
                                   Style="{StaticResource HeroSubtitleStyle}" Margin="0,6,0,0"/>

                        <WrapPanel Margin="0,18,0,0">
                            <Border Style="{StaticResource VersionBadgeStyle}">
                                <StackPanel>
                                    <TextBlock Text="INSTALLED VERSION" Style="{StaticResource VersionBadgeLabelStyle}"/>
                                    <TextBlock Text="{Binding GameVersion}" Style="{StaticResource VersionBadgeValueStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource VersionBadgeStyle}" Margin="10,0,0,0"
                                    Visibility="{Binding UpdateState.UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="AVAILABLE" Style="{StaticResource VersionBadgeLabelStyle}"/>
                                    <TextBlock Text="{Binding UpdateState.LatestUpdate.Version}" Style="{StaticResource VersionBadgeValueStyle}"
                                               Foreground="{StaticResource AmberBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource VersionBadgeStyle}" Margin="10,0,0,0"
                                    Visibility="{Binding UpdateState.UpdateAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="AUTO UPDATE" Style="{StaticResource VersionBadgeLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0"
                                                 Fill="{StaticResource SuccessBrush}"/>
                                        <TextBlock Text="Up to date" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0"
                                     Fill="{Binding GameStatus, Converter={StaticResource StatusToBrushConverter}}"/>
                            <TextBlock Text="{Binding GameStatus}" Style="{StaticResource HeroStatusStyle}"
                                       Foreground="{Binding GameStatus, Converter={StaticResource StatusToBrushConverter}}"/>
                            <TextBlock Text="•" Style="{StaticResource HeroStatusStyle}" Margin="8,0"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding GameTitleId, StringFormat='Title {0}'}" Style="{StaticResource HeroStatusStyle}"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Logo plate -->
                    <Border Grid.Column="1" Width="176" Height="176" CornerRadius="18" VerticalAlignment="Center"
                            Background="{StaticResource SurfaceLightBrush}"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                        <Image Source="/Resources/astrohybrid-mark.png" Width="124" Height="124"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Machine summary -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="GAME VERSION" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock Text="{Binding GameVersion}" Style="{StaticResource StatValueStyle}" FontSize="18"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="PROCESSOR" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock Text="{Binding CpuInfo}" Style="{StaticResource StatValueStyle}" FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="GRAPHICS" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock Text="{Binding GpuInfo}" Style="{StaticResource StatValueStyle}" FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource StatCardStyle}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="MEMORY" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock Text="{Binding RamInfo}" Style="{StaticResource StatValueStyle}" FontSize="18"/>
                        <TextBlock Text="{Binding DisplayInfo}" Style="{StaticResource StatDetailStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Current configuration -->
            <Border Style="{StaticResource ConfigCardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="CURRENT CONFIGURATION" Style="{StaticResource EyebrowTextStyle}"/>
                            <TextBlock Text="What the game will launch with" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="Change in Graphics" Command="{Binding NavigateToSettingsCommand}"
                                Style="{StaticResource TextButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                FontSize="12" Padding="8,4"/>
                    </Grid>
                    <Border Background="#12000000" CornerRadius="8" Padding="14,12" Margin="0,12,0,0"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding CurrentGraphicsConfig}" Style="{StaticResource ConfigTextStyle}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Release notes -->
            <Border Style="{StaticResource NewsCardStyle}" Margin="0,14,0,0"
                    Visibility="{Binding UpdateState.UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="WHAT'S NEW" Style="{StaticResource EyebrowTextStyle}"/>
                        <TextBlock Text="{Binding UpdateState.LatestUpdate.Version, StringFormat=' · {0}'}"
                                   Style="{StaticResource EyebrowTextStyle}" Foreground="{StaticResource AmberBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateState.LatestUpdate.ReleaseNotes}" Style="{StaticResource NewsTextStyle}"
                               TextWrapping="Wrap" MaxHeight="120" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Release notes" Command="{Binding NavigateToSettingsCommand}"
                                Style="{StaticResource TextButtonStyle}" FontSize="12" Padding="8,4"/>
                        <Button Content="Update now" Command="{Binding DownloadUpdateCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" MinWidth="112" MinHeight="34" Margin="10,0,0,0"
                                FontSize="12.5"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Shortcuts -->
            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="SHORTCUTS" Style="{StaticResource EyebrowTextStyle}"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Graphics" Command="{Binding NavigateToSettingsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" MinWidth="118" MinHeight="36" FontSize="12.5"/>
                        <Button Content="{Binding RayTracingToggleText}" Command="{Binding ToggleRayTracingCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" MinWidth="126" MinHeight="36" FontSize="12.5"
                                ToolTip="Toggle ray tracing between off (faster lighting) and on"/>
                        <Button Content="Controller" Command="{Binding NavigateToControllerCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" MinWidth="118" MinHeight="36" FontSize="12.5"/>
                        <Button Content="Installation" Command="{Binding NavigateToInstallationCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" MinWidth="118" MinHeight="36" FontSize="12.5"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
